# 아카이브 노드 필요 (고정 블록 포크). Alchemy / Infura 등.
RPC_URL=

# 포크 기준 블록. 확정 후 고정하고 변경하지 않는다.
FORK_BLOCK=

# 무료 Gemini Developer API 정책 컴파일러 (Google AI Studio에서 키 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MetaMask devnet/testnet 실행: 토큰 정보는 서버가 고정하고 지갑 주소는 연결된 MetaMask에서 받음
METAMASK_CHAIN_ID=
METAMASK_TOKEN_ADDRESS=
METAMASK_TOKEN_SYMBOL=
METAMASK_TOKEN_DECIMALS=

# 선택: Agent Wallet CLI가 PATH에 없을 때 mm.cmd/mm 실행 파일의 절대 경로
MM_CLI_PATH=

# Agent Wallet bundle 사전 시뮬레이션·컨텍스트·영수증 검증용 대상 체인 RPC
AGENT_WALLET_RPC_URL=

# 제어 실행 데모: 반드시 loopback Anvil과 그 노드에 배포한 ERC-20만 사용
ANVIL_RPC_URL=http://127.0.0.1:18547
CONTROLLED_CHAIN_ID=31337
CONTROLLED_WALLET_ADDRESS=
CONTROLLED_TOKEN_ADDRESS=
CONTROLLED_TOKEN_SYMBOL=CTT
CONTROLLED_TOKEN_DECIMALS=18

# 선택 사항: 명시적으로 Anthropic 어댑터를 사용할 때만 설정
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
