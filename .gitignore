# foundry
out/
cache/
broadcast/
# lib/ is NOT ignored: delegation-framework is pinned via git submodule and
# must be recorded in git (see chain/lib/delegation-framework). Only the
# framework's own build output stays ignored (handled by its nested .gitignore
# plus the out/cache/broadcast patterns above).

# local run artifacts (traces under traces/ ARE committed)
tmp/
*.log
